# Site-specific settings for FlowGuard++ on HoreKa.
# Copy to scripts/horeka/site.env and edit. Sourced by env.sh in every job.

# Keep datasets (~30 GB incl. raw downloads) and the HF cache on a workspace,
# not in the project checkout:
#   ws_allocate flowguard 60        # 60 days, extendable 3x
#   ws_find flowguard               # -> /hkfs/work/workspace/scratch/<user>-flowguard
# export FLOWGUARD_DATA_ROOT=/hkfs/work/workspace/scratch/<user>-flowguard/data

# Module that provides Python. The existing .sbatch files use this one.
# export FLOWGUARD_MODULES="jupyter/ai/2025-05-23"

# Virtualenv location (default: <project>/.venv).
# export FLOWGUARD_VENV=/path/to/venv

# PyTorch wheel index for setup_env.sh (default: PyPI, which ships CUDA 12 builds).
# export TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
