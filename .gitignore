# ---------------------------------------------------------------------------
# FlowGuard++ — files that must never enter the public repository
# ---------------------------------------------------------------------------

# --- Experiment outputs (tens of GB; regenerate with scripts/) --------------
/runs/
/logs/
/outputs/
/wandb/
/mlruns/
/lightning_logs/
*.sbatch.out
slurm-*.out
slurm-*.err

# --- Datasets (download via dataset.sh / torchvision) ----------------------
/data/
/datasets/

# --- Model weights & large binary artifacts -------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.tar
*.tar.gz
*.zip

# --- Manuscript (do not publish before the paper is public) ---------------
/paper/
*.pdf
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.acn
*.glo
*.ist

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# --- Environments ----------------------------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
.python-version
.conda/

# --- Testing / typing / linting caches ------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Editors / AI assistants / IDE state ----------------------------------
.vscode/
.idea/
.cursor/
.claude/
.aider*
.continue/
*.code-workspace
*.swp
*.swo
*~

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / credentials -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets.*
.netrc

# --- Vendored third-party checkouts ---------------------------------------
/FlowPure/

# --- Scratch ---------------------------------------------------------------
/scratch/
/tmp/
*.tmp
*.bak
*.orig
autoresearch-results.tsv
